{
  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# HireMinds AI – Resume & Job Description Matcher\n",
        "\n",
        "Upload a resume (PDF or TXT) and a job description (TXT) and see the matching result using the trained Random Forest model."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "source": [
        "import os, io, sys\n",
        "import pandas as pd\n",
        "import ipywidgets as widgets\n",
        "from IPython.display import display, Markdown\n",
        "\n",
        "# Ensure the project root is on the path\n",
        "project_root = os.path.abspath('.'); sys.path.append(project_root)\n",
        "\n",
        "# Import pipeline functions\n",
        "from src.pdf_parser import extract_text_from_pdf\n",
        "from src.preprocessing import clean_text\n",
        "from src.features import extract_and_build_features\n",
        "from src.predict import predict_candidate\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "source": [
        "# Helper to load a file (PDF or TXT) and return raw text\n",
        "def load_resume_from_bytes(content_bytes, filename=None):\n",
        "    """Load resume content either as PDF or plain text.
",
        "    If filename is not provided, we infer the type from the first bytes.
",
        "    """\n",
        "    # Infer extension
",
        "    if filename:
",
        "        ext = os.path.splitext(filename)[1].lower()
",
        "    else:
",
        "        # Simple PDF signature check
",
        "        ext = '.pdf' if content_bytes[:4] == b'%PDF' else '.txt'\n",
        "    if ext == '.pdf':\n",
        "        # Write to a temporary file so pdfplumber can read it
",
        "        temp_path = os.path.join('data', 'resumes', f'temp_uploaded{ext}')\n",
        "        with open(temp_path, 'wb') as f:\n",
        "            f.write(content_bytes)\n",
        "        return extract_text_from_pdf(temp_path)\n",
        "    else:\n",
        "        return content_bytes.decode('utf-8', errors='ignore')\n",
        "\n",
        "def load_job_from_bytes(content_bytes, filename=None):\n",
        "    # Job descriptions are always treated as plain text
",
        "    return content_bytes.decode('utf-8', errors='ignore')\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "source": [
        "# Upload widgets\n",
        "resume_uploader = widgets.FileUpload(\n",
        "    accept='.pdf,.txt',\n",
        "    multiple=False,\n",
        "    description='Upload Resume'\n",
        ")\n",
        "job_uploader = widgets.FileUpload(\n",
        "    accept='.txt',\n",
        "    multiple=False,\n",
        "    description='Upload Job Description'\n",
        ")\n",
        "display(resume_uploader)\n",
        "display(job_uploader)\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {},
      "execution_count": null,
      "source": [
        "def run_match():\n",
        "    # Verify both widgets have a file\n",
        "    if not resume_uploader.value or not job_uploader.value:\n",
        "        print('Please upload both a resume and a job description.')\n",
        "        return\n",
        "    # ----- Resolve resume -----\n",
        "    if isinstance(resume_uploader.value, dict):\n",
        "        # Newer ipywidgets (>=8) – dict keyed by filename\n",
        "        resume_key = next(iter(resume_uploader.value))\n",
        "        resume_file = resume_uploader.value[resume_key]\n",
        "        resume_name = resume_key\n",
        "    else:\n",
        "        # Older ipywidgets (<8) – tuple of Bunch objects\n",
        "        resume_file = resume_uploader.value[0]\n",
        "        resume_name = getattr(resume_file, 'metadata', {}).get('name')\n",
        "    # ----- Resolve job description -----\n",
        "    if isinstance(job_uploader.value, dict):\n",
        "        job_key = next(iter(job_uploader.value))\n",
        "        job_file = job_uploader.value[job_key]\n",
        "        job_name = job_key\n",
        "    else:\n",
        "        job_file = job_uploader.value[0]\n",
        "        job_name = getattr(job_file, 'metadata', {}).get('name')\n",
        "    # Helper to get raw bytes content\n",
        "    def get_content(file_obj):\n",
        "        if isinstance(file_obj, dict):\n",
        "            return file_obj['content']\n",
        "        return getattr(file_obj, 'content', None)\n",
        "    # Load texts using robust helpers\n",
        "    resume_bytes = get_content(resume_file)\n",
        "    job_bytes = get_content(job_file)\n",
        "    resume_text = load_resume_from_bytes(resume_bytes, resume_name)\n",
        "    job_text = load_job_from_bytes(job_bytes, job_name)\n",
        "    # Feature extraction & prediction\n",
        "    features, details = extract_and_build_features(resume_text, job_text)\n",
        "    prediction = predict_candidate(features)\n",
        "    # Display results\n",
        "    md = f'''\n",
        "    ### Prediction Result\n",
        "    **Candidate Skills:** {', '.join(sorted(details['candidate_skills']))}\n",
        "    **Required Skills:** {', '.join(sorted(details['required_skills']))}\n",
        "    **Matched Skills:** {', '.join(sorted(details['matched_skills']))}\n",
        "    **Missing Skills:** {', '.join(sorted(details['missing_skills']))}\n",
        "    **Jaccard Similarity:** {features['jaccard_similarity']*100:.2f}%\n",
        "    **Skill Coverage:** {features['skill_coverage']*100:.2f}%\n",
        "    **Experience Match:** {features['experience_match']*100:.2f}%\n",
        "    **Education Match:** {features['education_match']*100:.2f}%\n",
        "    **Random Forest Prediction:** {prediction['prediction']} (Probability: {prediction['probability']*100:.2f}%)\n",
        "    '''\n",
        "    display(Markdown(md))\n",
        "\n",
        "# Button to trigger the match\n",
        "run_match_button = widgets.Button(description='Run Match', button_style='success')\n",
        "run_match_button.on_click(lambda b: run_match())\n",
        "display(run_match_button)\n"
      ]
    }
  ],
